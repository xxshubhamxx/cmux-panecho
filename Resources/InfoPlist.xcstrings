{
  "sourceLanguage": "en",
  "strings": {
    "NSAppBundlesUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Panecho would like to access the contents of other apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Panecho 内で実行中のプログラムがほかのアプリのバンドル内容へのアクセスを求めています。"
          }
        }
      }
    },
    "NSAppDataUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Panecho would like to access data from other apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Panecho 内で実行中のプログラムがほかのアプリのデータへのアクセスを求めています。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب برنامج يعمل داخل Panecho في الوصول إلى صوت النظام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Program koji se izvršava unutar Panecho želi pristupiti zvuku sistema."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et program, der kører i Panecho, vil gerne have adgang til systemets lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in Panecho ausgeführtes Programm möchte auf das Systemaudio zugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Panecho would like to access your system's audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa en ejecución dentro de Panecho desea acceder al audio del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme s'exécutant dans Panecho souhaite accéder à l'audio du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programma in esecuzione in Panecho desidera accedere all'audio di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Panecho 内で実行中のプログラムがシステムオーディオへのアクセスを求めています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Panecho 내에서 실행 중인 프로그램이 시스템 오디오에 접근하려고 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et program som kjører i Panecho ønsker å få tilgang til systemlyden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program działający w Panecho chciałby uzyskać dostęp do dźwięku systemowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um programa em execução no Panecho gostaria de acessar o áudio do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа, запущенная в Panecho, хотела бы получить доступ к системному звуку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมที่ทำงานภายใน Panecho ต้องการเข้าถึงเสียงของระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panecho içinde çalışan bir program sistem sesine erişmek istiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Panecho 中运行的程序想要访问您的系统音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Panecho 中執行的程式想要存取您的系統音訊。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Panecho would like to use Bluetooth to discover passkeys and security keys."
